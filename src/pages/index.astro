---
import WebContainer from '../layouts/WebContainer.astro';
import ProfileCard from '../components/ProfileCard.jsx';
import ProjectLayout from '../components/ProjectLayout.astro';
import MacNavBar from '../components/MacNavBar.astro';

const projects = [
  { 
    id: 1, 
    title: 'Maneja Tu Proyecto', 
    url: 'https://gestiona-tu-proyecto-frontend.onrender.com/',
    description: "A project management app with dynamic roles. Learned teamwork and perseverance.",
    widthClass: 'sm:col-span-2',
    heightClass: ''
  },
  { 
    id: 2, 
    title: 'My First Web', 
    url: 'https://maquicosas.es.tl/Home.htm',
    description: "My first website from 2010. A nostalgic look at my early web development days.",
    widthClass: 'sm:col-span-2',
    heightClass: 'sm:row-span-2'
  },
  { 
    id: 3, 
    title: 'Sell In A Flash', 
    url: 'https://sell-in-a-flash-17dp.onrender.com/', 
    description: "A group project e-commerce site. My first serious web development experience.",
    widthClass: '',
    heightClass: ''
  },
  { 
    id: 4,
    title: 'Swiftstock',
    url: 'https://swiftstock.io/',
    description: "All-in-one web platform for managing second-hand mobile phone inventory, sales, and operations.",
    widthClass: '',
    heightClass: ''
  },
  {
    id: 5,
    title: 'Maabi',
    url: 'https://jimcollective.com/maabi/',
    description: "Web-based mall management system designed to centralize operations for tenants, employees, announcements, and more.",
    widthClass: '',
    heightClass: ''
  },
  {
    id: 6,
    title: 'CorporaciónBI',
    url: 'https://www.corporacionbi.com/gt/bancoindustrial/comparador-de-cuentas/',
    description: "Cross-page bank account comparator with an embeddable widget for consistent and dynamic comparisons.",
    widthClass: '',
    heightClass: ''
  },
  { 
    id: 7, 
    title: 'Harvard Memories', 
    url: 'https://harvard-memories.vercel.app/',
    description: "A personal scrapbook from my CS50 course. Showcases pure JavaScript experiments.",
    widthClass: '',
    heightClass: 'sm:row-span-2'
  },
  { 
    id: 8, 
    title: 'DevTo Fun', 
    url: 'https://devto-fun-home.vercel.app/',
    description: "A React-based UI for exploring Dev.to posts with dark/light themes.",
    widthClass: '',
    heightClass: ''
  },
  { 
    id: 9, 
    title: 'Airman Project', 
    url: 'https://airmanproject.vercel.app/',
    description: "An e-commerce site using BestBuy's API. A fun collaboration with friends.",
    widthClass: 'sm:col-span-2',
    heightClass: 'sm:row-span-2'
  },
  { 
    id: 10, 
    title: 'Vet Análisis Datos', 
    url: 'https://vetanalisisdatos.com/',
    description: "My first paid work: a Spanish data analysis course for veterinarians.",
    widthClass: '',
    heightClass: ''
  },
  { 
    id: 11, 
    title: 'CS50Thoughts', 
    url: 'https://cs50thoughts.vercel.app/',
    description: "A platform for sharing thoughts about CS50 with likes, dislikes, and filtering.",
    widthClass: 'sm:col-span-2',
    heightClass: ''
  }
];
---

<html lang="en">
<head>
	<!-- Global Metadata -->
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<!-- Primary Meta Tags -->
	<title>Johiny Dev</title>
	<meta name="title" content="Johiny Dev" />
	<meta name="description" content="Johiny's Projects Portfolio" />
	<meta name="keywords" content="web, dev, development, javascript, react, astro, css, html, software" />
	<!-- Favicon -->
	<link rel="icon" type="image/x-icon" href="/favicon.ico" />
</head>

<WebContainer>
  <MacNavBar linkedin="https://www.linkedin.com/in/johan-sebastian-c-mazo/" github="https://github.com/johiny" x="https://x.com/johinyDev" />
  <div class="layers-container">
    <!-- Grid superior: ProfileCard -->
    <div class="grid-layer profile-grid">
      <div class="profile-col">
        <div class="profile-card-wrapper">
          <ProfileCard client:only="react" />
        </div>
      </div>
    </div>
    <!-- Grid inferior: Projects -->
    <div class="grid-layer projects-grid">
      <div class="projects-col">
        <ProjectLayout {projects} />
      </div>
    </div>
  </div>
</WebContainer>

<style>
  .layers-container {
    position: relative;
  min-height: 100vh;
  height: 100vh; /* fuerza altura exacta para capas absolutas */
    padding: calc(var(--macbar-height, 56px) + 0.2rem) 1rem 1.5rem 1rem; /* leave space for fixed nav */
  }

  .grid-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
  height: 100%; /* se apoya en .layers-container */
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 1rem;
  }

  /* Profile grid por encima */
  .profile-grid {
    z-index: 10001; /* place profile grid above the nav */
    pointer-events: none; /* deja interactuar proyectos salvo card */
    position: relative;
  }
  .profile-card-wrapper {
    pointer-events: auto;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    width: 100%;
    max-width: none; /* quitar límite */
    margin-top: 0.25rem;
    position: relative;
    z-index: 10002; /* ensure card floats above nav */
  }
  .profile-col {
    grid-column: 1 / span 1;
    display: flex;
    align-items: stretch;
  }

  /* Projects grid debajo */
  .projects-grid {
    z-index: 10;
  }
  .projects-col {
    grid-column: 1 / -1;
    position: relative;
  height: 100%;
  overflow: visible; /* permite que hijos llenen altura */
  }

  /* Responsive: apilar (sin superposición) */
  @media (max-width: 768px) {
    .grid-layer {
      position: relative;
  height: auto;
    }
    .layers-container {
      padding-bottom: 2rem;
  height: auto; /* en móvil dejamos crecer */
    }
    .profile-grid {
      pointer-events: auto;
      margin-bottom: 1rem;
    }
    .profile-col, .projects-col {
      grid-column: 1 / -1;
    }
  }
</style>
</html>