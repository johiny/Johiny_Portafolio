---

<html lang="en">
<head>
	<!-- Global Metadata -->
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<!-- Primary Meta Tags -->
	<title>Johiny Dev</title>
	<meta name="title" content="Johiny Dev" />
	<meta name="description" content="Johiny's Projects Portfolio" />
	<meta name="keywords" content="web, dev, development, javascript, react, astro, css, html, software" />
	<!-- Favicon -->
	<link rel="icon" type="image/x-icon" href="/favicon.ico" />
</head>

<WebContainer>
  <MacNavBar />
  <SpotlightSearch />
  
  <Dock>
    <a href="https://www.linkedin.com/in/johan-sebastian-c-mazo/" target="_blank" rel="noopener noreferrer" class="dock-item" aria-label="LinkedIn">
