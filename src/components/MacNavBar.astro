---
// A macOS-like system menu bar (Time, Battery, Wifi, Menu items)
interface Props {
  linkedin?: string;
  github?: string;
  x?: string; 
}
const { linkedin, github, x } = Astro.props; // Props are now unused here but kept for compatibility
---

<style>
/* macOS Menu Bar Styles */
:root {
  --macbar-height: 32px; /* Authentic macOS height */
  --macbar-bg: rgba(255,255,255,0.3);
  --macbar-text: rgba(0,0,0,0.9);
  --macbar-text-shadow: none;
}

@media (prefers-color-scheme: dark) {
  :root {
    --macbar-bg: rgba(0,0,0,0.3);
    --macbar-text: rgba(255,255,255,0.95);
    --macbar-text-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }
}

:root[data-theme="light"] {
  --macbar-bg: rgba(255, 255, 255, 0.3);
  --macbar-text: rgba(0, 0, 0, 0.9);
  --macbar-text-shadow: none;
}

:root[data-theme="dark"] {
  --macbar-bg: rgba(12, 14, 28, 0.58);
  --macbar-text: rgba(255, 255, 255, 0.95);
  --macbar-text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
}

  .mac-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
    height: var(--macbar-height);
    box-sizing: border-box;
  display: flex;
  align-items: center;
  z-index: 10000;
  backdrop-filter: blur(20px) saturate(150%);
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  background: var(--macbar-bg);
  /* No border in modern macOS, just shadow or contrast */
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
  user-select: none;
  padding: 0 12px;
  justify-content: space-between;
  color: var(--macbar-text);
  font-size: 13px;
  font-weight: 500;
  text-shadow: var(--macbar-text-shadow);
}

.mac-left {
  display: flex;
  align-items: center;
  gap: 18px;
}

.mac-apple-logo {
  opacity: 0.9;
  display: flex;
  align-items: center;
}

.mac-app-name {
  font-weight: 700;
  cursor: default;
}

.mac-menu-items {
  display: flex;
  gap: 18px;
}

.mac-menu-item {
  cursor: default;
  opacity: 0.9;
}

.mac-menu-item:hover, .mac-apple-logo:hover {
  opacity: 0.6;
}

/* Hide menu items on mobile */
@media (max-width: 640px) {
  .mac-menu-items { display: none; }
  .mac-nav {
    height: calc(var(--macbar-height) + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    padding-left: 10px;
    padding-right: 10px;
    font-size: 12px;
  }

  .mac-left,
  .mac-right {
    gap: 10px;
  }

  .mac-status-item[title="Control Center"] {
    display: none;
  }
}

.mac-right {
  display: flex;
  align-items: center;
  gap: 14px;
}

.mac-status-item {
  display: flex;
  align-items: center;
  opacity: 0.9;
  cursor: default;
}

.mac-clock {
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}

.mac-restore-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 22px;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.2s ease;
  opacity: 0.6;
}

.mac-theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 22px;
  padding: 0;
  border: 0;
  border-radius: 6px;
  color: inherit;
  background: transparent;
  cursor: pointer;
  opacity: 0.72;
  transition: background 180ms ease, opacity 180ms ease, transform 180ms ease;
}

.mac-theme-toggle:hover {
  opacity: 1;
  background: rgba(0, 0, 0, 0.08);
}

.mac-theme-toggle:active {
  transform: scale(0.92);
}

.mac-theme-toggle:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

.mac-theme-toggle svg {
  width: 16px;
  height: 16px;
}

.theme-icon-moon {
  display: none;
}

:root[data-theme="dark"] .theme-icon-sun {
  display: none;
}

:root[data-theme="dark"] .theme-icon-moon {
  display: block;
}

.mac-restore-btn:hover {
  opacity: 1;
  background: rgba(0,0,0,0.08);
}

.mac-restore-btn:active {
  transform: scale(0.92);
}

.mac-restore-btn.has-closed {
  opacity: 1;
}

.mac-restore-btn.has-closed:hover {
  background: rgba(0,0,0,0.12);
}

.mac-restore-btn svg {
  width: 16px;
  height: 16px;
}

@media (prefers-color-scheme: dark) {
  .mac-restore-btn:hover {
    background: rgba(255,255,255,0.1);
  }
  .mac-restore-btn.has-closed:hover {
    background: rgba(255,255,255,0.15);
  }
  .mac-theme-toggle:hover {
    background: rgba(255,255,255,0.1);
  }
}

@media (max-width: 640px) {
  .mac-right {
    gap: 10px;
  }
}
</style>

<header class="mac-nav" role="navigation" aria-label="System Menu Bar">
  <!-- Left Side: Apple Logo + Menus -->
  <div class="mac-left">
    <div class="mac-apple-logo">
      <svg viewBox="0 0 17 20" width="15" height="15" fill="currentColor">
        <path d="M12.923 9.423c-.022-2.19 1.777-3.237 1.854-3.286-1.009-1.48-2.585-1.683-3.149-1.706-1.332-.136-2.6.786-3.277.786-.671 0-1.714-.766-2.825-.745-1.455.023-2.793.85-3.542 2.155-1.51 2.622-.387 6.505 1.077 8.647.723 1.045 1.572 2.227 2.697 2.185 1.076-.043 1.484-.698 2.783-.698 1.294 0 1.666.698 2.802.676 1.16-.021 1.896-1.054 2.607-2.097.818-1.2 1.155-2.362 1.163-2.424-.029-.011-2.235-.862-2.19-3.493M11.536 2.08c.594-.727.994-1.73.886-2.73-1.026.04-2.261.688-2.997 1.55-.544.629-.86 1.637-.751 2.604 1.144.089 2.296-.663 2.862-1.424"/>
      </svg>
    </div>
    
    <div class="mac-app-name">Johiny</div>
    
    <div class="mac-menu-items">
      <div class="mac-menu-item">File</div>
      <div class="mac-menu-item">Edit</div>
      <div class="mac-menu-item">View</div>
      <div class="mac-menu-item">Window</div>
      <div class="mac-menu-item">Help</div>
    </div>
  </div>

  <!-- Right Side: Status Icons + Clock -->
  <div class="mac-right">
    <!-- Restore Closed Windows Button -->
    <div class="mac-restore-btn" id="mac-restore-btn" onclick="restoreClosedCards()" title="Restore closed windows" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
        <path d="M3 3v5h5"/>
      </svg>
    </div>

    <!-- Light/Dark mode toggle -->
    <button class="mac-theme-toggle" id="mac-theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
      <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
      </svg>
      <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"></path>
      </svg>
    </button>

    <!-- Wifi -->
    <div class="mac-status-item" title="Wi-Fi">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
        </svg>
    </div>

    <!-- Battery -->
    <div class="mac-status-item" title="Battery: 100%">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20" stroke-width="2">
           <!-- Body -->
           <rect x="2" y="7" width="16" height="10" rx="2.5" ry="2.5"></rect>
           <!-- Cap -->
           <path d="M20 10v4" stroke-linecap="round"/>
           <!-- Fill -->
           <rect x="4.5" y="9.5" width="11" height="5" rx="0.5" fill="currentColor" stroke="none"></rect>
        </svg>
    </div>

    <!-- Control Center -->
    <div class="mac-status-item" title="Control Center">
         <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
         </svg>
    </div>

    <!-- Clock -->
    <div class="mac-status-item mac-clock">
        <span id="mac-clock-time">Mon Jun 22 9:41 AM</span>
    </div>
  </div>
</header>

<script is:inline>
  function updateClock() {
    const now = new Date();
    const options = { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' };
    const timeString = now.toLocaleDateString('en-US', options).replace(',', '');
    const clockEl = document.getElementById('mac-clock-time');
    if (clockEl) clockEl.textContent = timeString;
  }
  
  function restoreClosedCards() {
    const restoreBtn = document.getElementById('mac-restore-btn');
    const closedCards = document.querySelectorAll('.project-item.closed-state');
    
    closedCards.forEach(card => {
      card.classList.remove('closed-state', 'closing');
      card.style.position = '';
      card.style.transform = '';
      card.style.opacity = '';
      card.style.zIndex = '';
    });
    
    if (restoreBtn) {
      restoreBtn.setAttribute('hidden', '');
      restoreBtn.classList.remove('has-closed');
    }
  }

  function setTheme(theme) {
    document.documentElement.dataset.theme = theme;
    const toggle = document.getElementById('mac-theme-toggle');
    const isDark = theme === 'dark';

    if (toggle) {
      toggle.setAttribute('aria-pressed', String(isDark));
      toggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
      toggle.setAttribute('title', isDark ? 'Switch to light mode' : 'Switch to dark mode');
    }
  }

  function initializeTheme() {
    let savedTheme = null;
    try {
      savedTheme = localStorage.getItem('johiny-theme');
    } catch (error) {}

    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    setTheme(savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : systemTheme);

    const toggle = document.getElementById('mac-theme-toggle');
    toggle?.addEventListener('click', () => {
      const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      setTheme(nextTheme);
      try {
        localStorage.setItem('johiny-theme', nextTheme);
      } catch (error) {}
    });
  }
  
  // Monitor for closed cards and show restore button
  function monitorClosedCards() {
    const restoreBtn = document.getElementById('mac-restore-btn');
    const closedCards = document.querySelectorAll('.project-item.closed-state');
    
    if (restoreBtn) {
      if (closedCards.length > 0) {
        restoreBtn.removeAttribute('hidden');
        restoreBtn.classList.add('has-closed');
      } else {
        restoreBtn.setAttribute('hidden', '');
        restoreBtn.classList.remove('has-closed');
      }
    }
  }
  
  // Check for closed cards periodically
  setInterval(monitorClosedCards, 500);
  
  // Also monitor for class changes
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((m) => {
      if (m.type === 'attributes' && m.attributeName === 'class') {
        monitorClosedCards();
      }
    });
  });
  
  document.addEventListener('DOMContentLoaded', () => {
    initializeTheme();
    monitorClosedCards();
    document.querySelectorAll('.project-item').forEach(card => {
      observer.observe(card, { attributes: true });
    });
  });
  
  updateClock();
  setInterval(updateClock, 1000 * 30);
</script>
