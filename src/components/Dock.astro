<!-- Dock.astro -->
<div class="dock-wrapper">
  <div class="dock-container">
    <slot />
  </div>
</div>

<script>
  // Dock magnification effect
  const dockContainer = document.querySelector('.dock-container');
  const dockItems = dockContainer.querySelectorAll('.dock-item');
  
  const defaultScale = 1;
  const maxScale = 1.5;
  const range = 150; // pixels to affect neighbors

  dockContainer.addEventListener('mousemove', (e) => {
    const rect = dockContainer.getBoundingClientRect();
    const mouseX = e.clientX;

    dockItems.forEach(item => {
      const itemRect = item.getBoundingClientRect();
      const itemCenterX = itemRect.left + itemRect.width / 2;
      
      const distance = Math.abs(mouseX - itemCenterX);
      
      let scale = defaultScale;
      
      if (distance < range) {
        // Calculate scale based on distance (closer = bigger)
        // Cosine interpolation for smoother curve
        const normalizedDistance = distance / range;
        const interpolation = Math.cos(normalizedDistance * Math.PI / 2);
        scale = defaultScale + (maxScale - defaultScale) * interpolation;
      }
      
      item.style.width = `${48 * scale}px`;
      item.style.height = `${48 * scale}px`;
      item.style.transform = `translateY(-${(scale - 1) * 20}px)`; // Lift up slightly
    });
  });

  dockContainer.addEventListener('mouseleave', () => {
    dockItems.forEach(item => {
      item.style.width = '';
      item.style.height = '';
      item.style.transform = '';
    });
  });
</script>

<style>
  .dock-wrapper {
    position: fixed;
    bottom: calc(1.5rem + env(safe-area-inset-bottom));
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    z-index: 99999;
    pointer-events: none; /* Let clicks pass through wrapper */
  }

  .dock-container {
    pointer-events: auto;
    display: flex;
    align-items: center; /* Align bottom */
    gap: 8px;
    padding: 4px 10px; /* Reducido aún más de 6px 12px */
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 18px; /* Ajustado para el menor padding */
    box-shadow: 
      0 0 0 1px rgba(0,0,0,0.05),
      0 4px 30px rgba(0,0,0,0.1),
      inset 0 1px 0 rgba(255,255,255,0.4);
    transition: width 0.3s ease;
    height: 58px; /* Reducido ligeramente de 60px */
    box-sizing: content-box;
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    .dock-container {
      background: rgba(30, 30, 30, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 
        0 0 0 1px rgba(0,0,0,0.3),
        0 10px 40px rgba(0,0,0,0.4),
        inset 0 1px 0 rgba(255,255,255,0.15);
    }
  }

  :root[data-theme="dark"] .dock-container {
    background: rgba(16, 18, 34, 0.52);
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.28),
      0 10px 40px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  :root[data-theme="dark"] :global(.dock-item) {
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.24);
  }

  @media (max-width: 640px) {
    .dock-wrapper {
      bottom: calc(0.75rem + env(safe-area-inset-bottom));
      padding: 0 0.5rem;
    }

    .dock-container {
      gap: 5px;
      height: 48px;
      max-width: 100%;
      padding: 4px 7px;
      border-radius: 16px;
    }

    :global(.dock-item) {
      width: 40px;
      height: 40px;
      border-radius: 10px;
    }

    :global(.dock-item::after) {
      display: none;
    }
  }

  :global(.dock-item) {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.85);
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    transition: all 0.1s ease-out; /* Fast transition for smooth mouse move */
    cursor: pointer;
    position: relative;
    transform-origin: bottom center;
    color: #333;
  }
  
  /* Tooltips on hover */
  :global(.dock-item::after) {
    content: attr(aria-label);
    position: absolute;
    top: -40px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7);
    color: white;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 12px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    white-space: nowrap;
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  }
  
  :global(.dock-item:hover::after) {
    opacity: 1;
    transition-delay: 0.1s;
  }
  
  :global(.dock-item img), :global(.dock-item svg) {
    width: 65%;
    height: 65%;
    object-fit: contain;
    pointer-events: none;
  }
</style>
