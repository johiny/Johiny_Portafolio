---
const {img, title, url, description, class: className} = Astro.props
---

<div class={`project-card-content rounded-xl overflow-hidden shadow-lg transform transition duration-500 hover:scale-105 relative ${className || ''}`} data-newtab_url={url}>
    <img src={img} class='w-full h-full object-cover' alt={`photo of ${title}`}/>
    <div class="absolute inset-0 bg-midnightBlue bg-opacity-70 backdrop-blur-sm flex flex-col items-center justify-center opacity-0 hover:opacity-100 transition-opacity duration-300 p-3">
        <h2 class="text-lg font-bold mb-1 text-center text-aeroBlue">{title}</h2>
        <p class="text-xs text-center text-cuteWhite">{description}</p>
    </div>
</div>

<style>
    .project-card-content {
        --cardShadow: 0 4px 30px rgba(47, 4, 71, 0.4);
        box-shadow: var(--cardShadow);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        border: 2px solid rgba(255, 255, 255, 0.1);
        cursor: pointer;
        transition: all 0.6s ease;
        aspect-ratio: 1 / 1;
    }
    
    :root[data-theme='light'] .project-card-content {
        --cardShadow:0 4px 20px rgba(18, 18, 18, 0.4);
    }
    
    .project-card-content:hover {
        transform: translateY(-5px);
    }
    
    /* Specific styles for non-square cards */
    .sm\:col-span-2 {
        aspect-ratio: 2 / 1;
    }
    
    .sm\:row-span-2 {
        aspect-ratio: 1 / 2;
    }
    
    .sm\:col-span-2.sm\:row-span-2 {
        aspect-ratio: 2 / 2;
    }
    
    /* Adjust font sizes for smaller cards */
    @media (max-width: 640px) {
        .project-card-content h2 {
            font-size: 0.875rem;
        }
        
        .project-card-content p {
            font-size: 0.75rem;
        }
    }
</style>

<script>
    class ProjectCard extends HTMLElement {
        constructor() {
            super();
            
            this.addEventListener('click', () => {
                window.open(this.dataset.newtab_url, '_blank');
            });
        }
    }
    
    customElements.define('project-card', ProjectCard);
</script>