---
// src/components/WrappedProjectsContainer.astro
interface Props {
  projects: Array<{ 
    id: number; 
    title: string; 
    description: string; 
    url: string;
  }>;
}

const { projects } = Astro.props;

// Definir diferentes iconos minimalistas para cada proyecto con colores del gradiente macOS
const projectIcons = [
  // Icono 1: Código (My First Web) - Rosa coral
  '<svg class="w-12 h-12 gradient-icon-1" fill="none" stroke="#ff9a9e" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>',
  // Icono 2: Tienda (Sell In A Flash) - Melocotón
  '<svg class="w-12 h-12 gradient-icon-2" fill="none" stroke="#fad0c4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>',
  // Icono 3: Gestión (Maneja Tu Proyecto) - Azul lavanda
  '<svg class="w-12 h-12 gradient-icon-3" fill="none" stroke="#a1c4fd" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>',
  // Icono 4: Memoria/Foto (Harvard Memories) - Azul cielo
  '<svg class="w-12 h-12 gradient-icon-4" fill="none" stroke="#c2e9fb" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>',
  // Icono 5: Dev.to (DevTo Fun) - Rosa coral intenso
  '<svg class="w-12 h-12 gradient-icon-1" fill="none" stroke="#ff9a9e" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>',
  // Icono 6: Aviación (Airman Project) - Melocotón
  '<svg class="w-12 h-12 gradient-icon-2" fill="none" stroke="#fad0c4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>',
  // Icono 7: Gráfico/Datos (Vet Análisis Datos) - Azul lavanda
  '<svg class="w-12 h-12 gradient-icon-3" fill="none" stroke="#a1c4fd" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>',
  // Icono 8: Pensamiento/Idea (CS50Thoughts) - Azul cielo
  '<svg class="w-12 h-12 gradient-icon-4" fill="none" stroke="#c2e9fb" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>'
];

// Clases de texto con gradientes para títulos
const gradientTitleClasses = [
  'gradient-text-title-1', // Rosa coral
  'gradient-text-title-2', // Melocotón  
  'gradient-text-title-3', // Azul lavanda
  'gradient-text-title-4', // Azul cielo
  'gradient-text-title-1', // Repetir patrón
  'gradient-text-title-2',
  'gradient-text-title-3', 
  'gradient-text-title-4'
];

// Clases de texto con gradientes para descripciones
const gradientDescClasses = [
  'gradient-text-desc-1', // Rosa coral suave
  'gradient-text-desc-2', // Melocotón suave
  'gradient-text-desc-3', // Azul lavanda suave
  'gradient-text-desc-4', // Azul cielo suave
  'gradient-text-desc-1', // Repetir patrón
  'gradient-text-desc-2',
  'gradient-text-desc-3',
  'gradient-text-desc-4'
];

// Tamaños tipo "bento" deterministas (evita parpadeo al re-render)
function bentoSize(index: number) {
  const sizes = [
    'w-[18rem] h-[18rem]',
    'w-[22rem] h-[18rem]',
    'w-[18rem] h-[24rem]',
    'w-[26rem] h-[20rem]',
    'w-[20rem] h-[20rem]',
    'w-[24rem] h-[26rem]',
    'w-[18rem] h-[22rem]',
    'w-[22rem] h-[24rem]'
  ];
  return sizes[index % sizes.length];
}
---

<!-- Carrusel horizontal infinito -->
<div class="projects-infinite-wrapper relative h-full w-full overflow-hidden">
  <div id="wrapped-projects-container" class="infinite-container scrollbar-hide" style="scrollbar-width:none; -ms-overflow-style:none;">
    <div class="projects-track">
      {(() => {
        // Precomputar tamaños deterministas para consistencia entre duplicados
        const sizes = projects.map((_, i) => bentoSize(i));
        // Duplicar los proyectos para crear el efecto infinito
        const duplicatedProjects = [...projects, ...projects];
        
        return duplicatedProjects.map((project, index) => {
          const originalIndex = index % projects.length;
          return (
            <a 
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`project-item preload glass-card group ${sizes[originalIndex]} rounded-3xl shadow-lg transition-all duration-300 overflow-hidden transform hover:-translate-y-1 hover:scale-105`}
              data-index={originalIndex}
              data-duplicate={index >= projects.length ? 'true' : 'false'}
            >
              <!-- Window Controls (macOS style) -->
              <div class="window-controls absolute top-3 left-3 flex space-x-2 z-10 transition-all duration-300">
                <div class="window-control-btn window-control-close"></div>
                <div class="window-control-btn window-control-minimize"></div>
                <div class="window-control-btn window-control-maximize"></div>
              </div>
              
              <div class="project-item-inner flex flex-col items-center justify-center p-6 h-full">
                <div class="project-icon w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-50/50 to-purple-50/50 flex items-center justify-center border-white/20 mb-4">
                  <div set:html={projectIcons[originalIndex % projectIcons.length]} />
                </div>
                <h3 class={`project-title project-text-base text-lg font-semibold mb-2 text-center leading-tight ${gradientTitleClasses[originalIndex % gradientTitleClasses.length]}`}>{project.title}</h3>
                <p class={`project-desc project-text-base text-center text-sm line-clamp-3 leading-relaxed ${gradientDescClasses[originalIndex % gradientDescClasses.length]}`}>{project.description}</p>
              </div>
            </a>
          );
        });
      })()}
    </div>
  </div>
  
  <!-- Indicadores de scroll (opcional) -->
  <div class="scroll-indicators absolute bottom-4 left-1/2 transform -translate-x-1/2 flex space-x-2 z-10">
    <div class="scroll-indicator w-2 h-2 bg-white/30 rounded-full"></div>
    <div class="scroll-indicator w-2 h-2 bg-white/30 rounded-full"></div>
    <div class="scroll-indicator w-2 h-2 bg-white/50 rounded-full"></div>
  </div>
</div>

<!-- Botón visual macOS (solo UI) en la esquina inferior derecha -->
<div id="macos-restore-button" class="macos-restore-button" role="button" tabindex="0" aria-label="Restaurar ventanas cerradas" hidden>
  <div class="macos-restore-button-inner">
    <span class="macos-restore-label">Restore</span>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('wrapped-projects-container');
    const track = container?.querySelector('.projects-track');
    const actionButton = document.getElementById('macos-restore-button');
    if (!container || !track) return;

    // Obtener los proyectos desde los elementos del DOM
    const initialCards = Array.from(track.querySelectorAll('.project-item'));
    const projects = [];
    
    // Extraer información de los proyectos desde las tarjetas existentes
    initialCards.forEach((card, index) => {
      const originalIndex = parseInt(card.getAttribute('data-index')) || 0;
      if (originalIndex < projects.length) return; // Evitar duplicados
      
      const title = card.querySelector('.project-title')?.textContent || `Project ${originalIndex + 1}`;
      const description = card.querySelector('.project-desc')?.textContent || `Description for project ${originalIndex + 1}`;
      const url = card.href || '#';
      
      projects.push({
        id: originalIndex,
        title,
        description,
        url
      });
    });

    // Asegurar que tenemos los proyectos únicos
    const uniqueProjects = projects.filter((project, index, self) => 
      index === self.findIndex(p => p.id === project.id)
    );

    console.log('Proyectos cargados:', uniqueProjects);

    // Array que rastrea los elementos que han recibido la clase 'closed-state'
    const closedProjects = [];

    // --- Audio System (Efectos de sonido UI) ---
    let audioContext = null;

    function playHoverSound() {
      try {
        if (!audioContext) {
          audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioContext.state === 'suspended') {
           audioContext.resume().catch(() => {});
        }

        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();
        
        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);
        
        // Sonido "Glass Pop" sutil y elegante
        oscillator.type = 'sine';
        // Tono puro y limpio que sube levemente
        oscillator.frequency.setValueAtTime(500, audioContext.currentTime); 
        oscillator.frequency.exponentialRampToValueAtTime(800, audioContext.currentTime + 0.05); 
        
        // Envolvente de volumen muy suave (fade in/out rápido)
        gainNode.gain.setValueAtTime(0, audioContext.currentTime);
        gainNode.gain.linearRampToValueAtTime(0.015, audioContext.currentTime + 0.01);
        gainNode.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.1);
        
        oscillator.start();
        oscillator.stop(audioContext.currentTime + 0.1);
      } catch (e) {
        // Fallback silencioso si el audio no está permitido
      }
    }
    
    // Estado para el scroll infinito dinámico
    let currentBatch = 0;
    let isLoading = false;
    const BATCH_SIZE = uniqueProjects.length; // Cargar el mismo número de proyectos cada vez
    let allProjectCards = [...uniqueProjects, ...uniqueProjects]; // Empezar con proyectos duplicados

    function updateRestoreButton() {
      if (!actionButton) return;
      if (closedProjects.length > 0) {
        actionButton.removeAttribute('hidden');
        actionButton.classList.add('show');
        actionButton.setAttribute('aria-label', `Restaurar ${closedProjects.length} ventanas`);
        actionButton.style.pointerEvents = 'auto';
      } else {
        actionButton.classList.remove('show');
        actionButton.setAttribute('aria-label', 'Restaurar ventanas cerradas');
        actionButton.style.pointerEvents = 'none';
        actionButton.setAttribute('hidden', '');
      }
    }

    function addClosedProject(projectItem) {
      if (!projectItem) return;
      if (!closedProjects.includes(projectItem)) {
        closedProjects.push(projectItem);
      }
      // Log current closed projects for debugging (count + data-indexes)
      try {
        const indexes = closedProjects.map(p => p.getAttribute && p.getAttribute('data-index'));
        console.log('closedProjects ADDED -> count:', closedProjects.length, 'indexes:', indexes);
      } catch (err) {
        console.log('closedProjects ADDED -> count:', closedProjects.length);
      }
      updateRestoreButton();
    }

    function removeClosedProject(projectItem) {
      const idx = closedProjects.indexOf(projectItem);
      if (idx !== -1) closedProjects.splice(idx, 1);
      // Log current closed projects for debugging (count + data-indexes)
      try {
        const indexes = closedProjects.map(p => p.getAttribute && p.getAttribute('data-index'));
        console.log('closedProjects REMOVED -> count:', closedProjects.length, 'indexes:', indexes);
      } catch (err) {
        console.log('closedProjects REMOVED -> count:', closedProjects.length);
      }
      updateRestoreButton();
    }

    // Función para crear una nueva tarjeta HTML dinámicamente
    function createProjectCard(project, index, isDuplicate = false) {
      const originalIndex = index % uniqueProjects.length;
      const sizes = [
        'w-[18rem] h-[18rem]',
        'w-[22rem] h-[18rem]',
        'w-[18rem] h-[24rem]',
        'w-[26rem] h-[20rem]',
        'w-[20rem] h-[20rem]',
        'w-[24rem] h-[26rem]',
        'w-[18rem] h-[22rem]',
        'w-[22rem] h-[24rem]'
      ];
      
      const projectIcons = [
        '<svg class="w-12 h-12 gradient-icon-1" fill="none" stroke="#ff9a9e" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-2" fill="none" stroke="#fad0c4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-3" fill="none" stroke="#a1c4fd" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-4" fill="none" stroke="#c2e9fb" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-1" fill="none" stroke="#ff9a9e" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-2" fill="none" stroke="#fad0c4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-3" fill="none" stroke="#a1c4fd" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-4" fill="none" stroke="#c2e9fb" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>'
      ];

      const gradientTitleClasses = [
        'gradient-text-title-1', 'gradient-text-title-2', 'gradient-text-title-3', 'gradient-text-title-4',
        'gradient-text-title-1', 'gradient-text-title-2', 'gradient-text-title-3', 'gradient-text-title-4'
      ];

      const gradientDescClasses = [
        'gradient-text-desc-1', 'gradient-text-desc-2', 'gradient-text-desc-3', 'gradient-text-desc-4',
        'gradient-text-desc-1', 'gradient-text-desc-2', 'gradient-text-desc-3', 'gradient-text-desc-4'
      ];

      const cardElement = document.createElement('a');
      cardElement.href = project.url;
      cardElement.target = '_blank';
      cardElement.rel = 'noopener noreferrer';
      // Usar dynamic-entry para tarjetas nuevas, preload para mantener compatibilidad
      const entryClass = isDuplicate ? 'dynamic-entry' : 'preload';
      cardElement.className = `project-item ${entryClass} glass-card group ${sizes[originalIndex]} rounded-3xl shadow-lg transition-all duration-300 overflow-hidden transform hover:-translate-y-1 hover:scale-105`;
      cardElement.setAttribute('data-index', originalIndex);
      cardElement.setAttribute('data-duplicate', isDuplicate ? 'true' : 'false');

      cardElement.innerHTML = `
        <div class="window-controls absolute top-3 left-3 flex space-x-2 z-10 transition-all duration-300">
          <div class="window-control-btn window-control-close"></div>
          <div class="window-control-btn window-control-minimize"></div>
          <div class="window-control-btn window-control-maximize"></div>
        </div>
        
        <div class="project-item-inner flex flex-col items-center justify-center p-6 h-full">
          <div class="project-icon w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-50/50 to-purple-50/50 flex items-center justify-center border-white/20 mb-4">
            <div>${projectIcons[originalIndex % projectIcons.length]}</div>
          </div>
          <h3 class="project-title project-text-base text-lg font-semibold mb-2 text-center leading-tight ${gradientTitleClasses[originalIndex % gradientTitleClasses.length]}">${project.title}</h3>
          <p class="project-desc project-text-base text-center text-sm line-clamp-3 leading-relaxed ${gradientDescClasses[originalIndex % gradientDescClasses.length]}">${project.description}</p>
        </div>
      `;

      return cardElement;
    }

    // Función para cargar más tarjetas dinámicamente
    function loadMoreCards() {
      if (isLoading) return;
      
      isLoading = true;
      // console.log(`Cargando batch ${currentBatch + 1}...`);
      
      requestAnimationFrame(() => {
        const newCards = [];
        
        // Agregar una nueva tanda de proyectos (rotando a través de los proyectos originales)
        for (let i = 0; i < BATCH_SIZE; i++) {
          const projectIndex = i % uniqueProjects.length;
          const newCard = createProjectCard(uniqueProjects[projectIndex], projectIndex, true);
          newCards.push(newCard);
          allProjectCards.push(uniqueProjects[projectIndex]);
        }
        
        // Agregar las nuevas tarjetas al DOM con animación y estilos masonry
        newCards.forEach((card, index) => {
          track.appendChild(card);
          
          // Aplicar estilos masonry basados en el índice total de tarjetas
          const totalCards = track.querySelectorAll('.project-item').length;
          const cardPosition = totalCards - newCards.length + index;
          applyMasonryStyles(card, cardPosition);
          
          // Forzar la aplicación de estilos de gradiente
          forceGradientStyles(card, index);
          
          // Configurar event listeners para los window controls de la nueva tarjeta
          setupCardEventListeners(card);
          
          // Animar la entrada de la nueva tarjeta
          requestAnimationFrame(() => {
            card.classList.add('loaded');
            // Volver a aplicar estilos después de la animación para asegurar que se mantengan
            forceGradientStyles(card, index);
          });
        });
        
        currentBatch++;
        isLoading = false;
        // console.log(`Batch ${currentBatch} cargado. Total cards: ${allProjectCards.length}`);
      });
    }

    // Función para aplicar estilos masonry a una tarjeta específica
    function applyMasonryStyles(card, position) {
      // Remover estilos masonry existentes
      card.style.alignSelf = '';
      card.style.marginTop = '';
      
      // Aplicar estilos masonry basados en la posición
      const remainder = position % 5;
      
      switch(remainder) {
        case 0:
          card.style.alignSelf = 'flex-start';
          break;
        case 1:
          card.style.alignSelf = 'center';
          break;
        case 2:
          card.style.alignSelf = 'flex-end';
          break;
        case 3:
          card.style.alignSelf = 'flex-start';
          card.style.marginTop = '2rem';
          break;
        case 4:
          card.style.alignSelf = 'center';
          card.style.marginTop = '1rem';
          break;
      }
    }

    // Función para forzar la aplicación de estilos de gradiente
    function forceGradientStyles(card, index) {
      const projectIndex = parseInt(card.getAttribute('data-index')) || 0;
      
      const gradientTitleClasses = [
        'gradient-text-title-1', 'gradient-text-title-2', 'gradient-text-title-3', 'gradient-text-title-4',
        'gradient-text-title-1', 'gradient-text-title-2', 'gradient-text-title-3', 'gradient-text-title-4'
      ];

      const gradientDescClasses = [
        'gradient-text-desc-1', 'gradient-text-desc-2', 'gradient-text-desc-3', 'gradient-text-desc-4',
        'gradient-text-desc-1', 'gradient-text-desc-2', 'gradient-text-desc-3', 'gradient-text-desc-4'
      ];

      const title = card.querySelector('.project-title');
      const desc = card.querySelector('.project-desc');
      
      if (title) {
        // Remover todas las clases de gradiente existentes
        gradientTitleClasses.forEach(cls => title.classList.remove(cls));
        // Agregar la clase correcta
        title.classList.add(gradientTitleClasses[projectIndex % gradientTitleClasses.length]);
        
        // Aplicar estilos inline como fallback para asegurar que se vean
        const titleStyles = {
          0: 'linear-gradient(45deg, #e11d48, #f43f5e)',
          1: 'linear-gradient(45deg, #ea580c, #f59e0b)',
          2: 'linear-gradient(45deg, #2563eb, #3b82f6)',
          3: 'linear-gradient(45deg, #0284c7, #0891b2)'
        };
        
        const styleIndex = projectIndex % 4;
        title.style.background = titleStyles[styleIndex];
        title.style.webkitBackgroundClip = 'text';
        title.style.backgroundClip = 'text';
        title.style.webkitTextFillColor = 'transparent';
        title.style.fontWeight = '700';
        
        // Text-shadow específico para cada color
        title.style.textShadow = '0 1px 2px rgba(0,0,0,0.1)';
      }
      
      if (desc) {
        // Remover todas las clases de gradiente existentes
        gradientDescClasses.forEach(cls => desc.classList.remove(cls));
        // Agregar la clase correcta
        desc.classList.add(gradientDescClasses[projectIndex % gradientDescClasses.length]);
        
        // Reiniciar estilos inline para garantizar texto sólido
        desc.style.background = 'none';
        desc.style.webkitBackgroundClip = 'border-box';
        desc.style.backgroundClip = 'border-box';
        desc.style.webkitTextFillColor = 'initial';
        desc.style.color = 'rgba(30, 41, 59, 0.95)'; // Slate 800
        desc.style.fontWeight = '500';
        desc.style.textShadow = '0 1px 0 rgba(255, 255, 255, 0.8)';
      }
      
      console.log(`Estilos de gradiente aplicados a tarjeta ${projectIndex}`);
    }

    // Función para configurar event listeners en una tarjeta
    function setupCardEventListeners(card) {
      // Configurar hover para pausar scroll
      card.addEventListener('mouseenter', () => {
        isPaused = true;
        playHoverSound(); // Efecto de sonido
        // console.log('Auto-scroll pausado (hover sobre nueva tarjeta) — data-index:', card.getAttribute('data-index'));
      });

      card.addEventListener('mouseleave', () => {
        const anyHover = Array.from(track.querySelectorAll('.project-item')).some(c => c.matches(':hover'));
        if (!anyHover) {
          isPaused = false;
          console.log('Auto-scroll reanudado (ya no hay hover en tarjetas)');
        }
      });

      // Configurar window controls
      const windowControls = card.querySelectorAll('.window-control-btn');
      windowControls.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const projectItem = btn.closest('.project-item');

          if (btn.classList.contains('window-control-close')) {
            handleWindowControl(e, 'close', projectItem);
          } else if (btn.classList.contains('window-control-minimize')) {
            handleWindowControl(e, 'minimize', projectItem);
          } else if (btn.classList.contains('window-control-maximize')) {
            handleWindowControl(e, 'maximize', projectItem);
          }
        });
      });

      // Efecto Spotlight (Seguimiento del mouse)
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        // Actualizar variables CSS para la posición del brillo
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    }

    let isPaused = false;
    let animationId = null;
    let isDragging = false;
    let startX = 0;
    let scrollLeft = 0;
    let wheelTimeout = null; // Para pausar temporalmente el auto-scroll
    let preciseScrollLeft = 0;
    let lastTimestamp = 0;
    const SCROLL_SPEED_PPS = 60; // Pixels per second

    // Scroll automático con carga dinámica infinita
    function autoScroll(timestamp) {
      if (!lastTimestamp || isPaused || isDragging) {
        lastTimestamp = timestamp;
      }
      
      if (!isPaused && !isDragging) {
        const deltaTime = timestamp - lastTimestamp;
        lastTimestamp = timestamp;
        
        // Use delta time for smooth speed regardless of frame rate
        const pixelsToMove = (SCROLL_SPEED_PPS * deltaTime) / 1000;
        
        // If container.scrollLeft changed externally (e.g. initial load or constraints), sync it
        if (Math.abs(container.scrollLeft - preciseScrollLeft) > 5) {
             preciseScrollLeft = container.scrollLeft;
        }

        preciseScrollLeft += pixelsToMove;
        container.scrollLeft = preciseScrollLeft;

        // Verificar si estamos cerca del final y necesitamos cargar más tarjetas
        const scrollPosition = container.scrollLeft;
        const maxScroll = container.scrollWidth - container.clientWidth;
        const threshold = maxScroll * 0.8; // Cargar más cuando estemos al 80% del final
        
        if (scrollPosition >= threshold && !isLoading) {
          // console.log('Cerca del final, cargando más tarjetas...');
          loadMoreCards();
        }
      } else {
         // Sync when paused so we resume smoothly
         preciseScrollLeft = container.scrollLeft;
      }
      animationId = requestAnimationFrame(autoScroll);
    }

    // Iniciar inmediatamente después de que el DOM esté listo
    setTimeout(() => {
      console.log('Iniciando scroll automático...');
      // Inicializar posición precisa para evitar saltos o NaN
      preciseScrollLeft = container.scrollLeft;
      requestAnimationFrame(autoScroll);
    }, 100);

    // Animación de entrada para las project cards: las tarjetas se renderizan
    // inicialmente con la clase `preload` (render server-side) para que el
    // primer paint las muestre fuera de su posición final. Aquí añadimos
    // `.loaded` en un stagger usando rAF para animarlas suavemente hacia su
    // posición original sin parpadeos.
    function animateCardsIn() {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cards = Array.from(track.querySelectorAll('.project-item'));

      if (prefersReduced) {
        // Remove preload so they render in place immediately
        cards.forEach(c => c.classList.remove('preload'));
        cards.forEach(c => c.classList.add('loaded'));
        return;
      }

      // Ensure `.preload` is present before scheduling `.loaded`.
      // Then use requestAnimationFrame and a small stagger to add `.loaded`.
      requestAnimationFrame(() => {
        let i = 0;
        const step = () => {
          if (i >= cards.length) {
            // Clean up `preload` after all cards have started animating
            setTimeout(() => cards.forEach(c => c.classList.remove('preload')), 600);
            return;
          }
          cards[i].classList.add('loaded');
          i += 1;
          // small timeout between items to create a pleasing cascade
          setTimeout(() => requestAnimationFrame(step), 40);
        };
        step();
      });
    }

    // Run entrance animation shortly after mount so layout has stabilized
    setTimeout(animateCardsIn, 80);

    // Pausar solo con hover
    container.addEventListener('mouseenter', () => {
      isPaused = true;
      console.log('Pausado');
    });

    container.addEventListener('mouseleave', () => {
      isPaused = false;
      console.log('Reanudado');
    });

    // El scroll automático se pausará únicamente mientras el cursor esté sobre
    // alguna tarjeta `.project-item`. Cuando no haya ninguna tarjeta en hover,
    // se reanudará automáticamente.

    // Primero removemos (si existen) los listeners previos en el container
    container.replaceWith = container.replaceWith; // noop para evitar lint; no eliminar

    // Configurar event listeners para las tarjetas iniciales (ya declaradas arriba)
    initialCards.forEach(card => {
      setupCardEventListeners(card);
    });

    // Eliminar/ignorar pause por hover en todo el contenedor (evitar duplicidad)
    // Si ya existían listeners `container.addEventListener('mouseenter' ...)`,
    // bórralos o coméntalos para evitar conflicto.

    // Wheel scroll - Convertir scroll vertical en horizontal con carga dinámica
    container.addEventListener('wheel', (e) => {
      e.preventDefault();
      
      // Pausar el scroll automático temporalmente cuando el usuario usa la rueda
      isPaused = true;
      if (wheelTimeout) clearTimeout(wheelTimeout);
      
      // Usar deltaY (scroll vertical) para controlar scrollLeft (scroll horizontal)
      const scrollSpeed = 3; // Velocidad de scroll ajustable
      const newScrollPosition = container.scrollLeft + (e.deltaY * scrollSpeed);
      
      // Verificar si necesitamos cargar más tarjetas antes de hacer scroll
      const maxScroll = container.scrollWidth - container.clientWidth;
      const threshold = maxScroll * 0.8;
      
      if (newScrollPosition >= threshold && !isLoading) {
        console.log('Wheel scroll cerca del final, cargando más tarjetas...');
        loadMoreCards();
      }
      
      // Aplicar el scroll
      container.scrollLeft = newScrollPosition;
      
      // Prevenir scroll negativo
      if (container.scrollLeft < 0) {
        container.scrollLeft = 0;
      }
      
      // Reanudar el scroll automático después de 2 segundos de inactividad
      wheelTimeout = setTimeout(() => {
        isPaused = false;
        console.log('Auto-scroll reanudado después de usar la rueda');
      }, 2000);
      
    }, { passive: false });

    // Drag functionality
    function startDragging(e) {
      isDragging = true;
      container.style.cursor = 'grabbing';
      startX = (e.pageX || e.touches[0].pageX) - container.offsetLeft;
      scrollLeft = container.scrollLeft;
    }

    function stopDragging() {
      isDragging = false;
      container.style.cursor = 'grab';
    }

    function drag(e) {
      if (!isDragging) return;
      e.preventDefault();
      const x = (e.pageX || e.touches[0].pageX) - container.offsetLeft;
      const walk = (x - startX) * 2;
      container.scrollLeft = scrollLeft - walk;
    }

    // Event listeners
    container.addEventListener('mousedown', startDragging);
    container.addEventListener('touchstart', startDragging, { passive: true });
    document.addEventListener('mouseup', stopDragging);
    document.addEventListener('touchend', stopDragging);
    document.addEventListener('mousemove', drag);
    document.addEventListener('touchmove', drag, { passive: true });

    // Window Controls functionality
    function handleWindowControl(e, action, projectItem) {
      e.preventDefault();
      e.stopPropagation();

      // Remover clases de animación y estado previas
      projectItem.classList.remove('closing', 'minimizing', 'maximizing', 'restoring');
      projectItem.classList.remove('closed-state', 'minimized-state', 'maximized-state');

      switch(action) {
        case 'close':
          projectItem.classList.add('closing');
          setTimeout(() => {
            projectItem.classList.remove('closing');
            projectItem.classList.add('closed-state');
            // Añadir a la lista de cerrados cuando la clase ya está aplicada
            addClosedProject(projectItem);
          }, 600);
          break;

        case 'minimize':
          projectItem.classList.add('minimizing');
          setTimeout(() => {
            projectItem.classList.remove('minimizing');
            projectItem.classList.add('minimized-state');
          }, 600);
          break;

        case 'maximize':
          projectItem.classList.add('maximizing');
          setTimeout(() => {
            projectItem.classList.remove('maximizing');
            projectItem.classList.add('maximized-state');
          }, 400);
          break;
      }
    }

    // Función para restaurar tarjeta desde el borde - USA TRANSICIÓN CSS
    function restoreCard(projectItem) {
      // Remover estados y permitir que la transición CSS haga el trabajo
      projectItem.classList.remove('closed-state', 'minimized-state', 'maximized-state');
      // Limpiar estilos inline aplicados por JavaScript
      projectItem.style.position = '';
      projectItem.style.top = '';
      projectItem.style.left = '';
      projectItem.style.transform = '';
      projectItem.style.zIndex = '';

      // Quitar de la lista de cerrados si estaba ahí
      removeClosedProject(projectItem);
      // La transición CSS automáticamente animará de vuelta al estado original
    }

    // Agregar event listeners a todos los window controls
    document.querySelectorAll('.window-control-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const projectItem = btn.closest('.project-item');

        if (btn.classList.contains('window-control-close')) {
          handleWindowControl(e, 'close', projectItem);
        } else if (btn.classList.contains('window-control-minimize')) {
          handleWindowControl(e, 'minimize', projectItem);
        } else if (btn.classList.contains('window-control-maximize')) {
          handleWindowControl(e, 'maximize', projectItem);
        }
      });
    });

    // Event listener para restaurar tarjetas clickeando en ellas cuando están en los bordes
    document.addEventListener('click', (e) => {
      const projectItem = e.target.closest('.project-item');
      if (projectItem && (
        projectItem.classList.contains('closed-state') ||
        projectItem.classList.contains('minimized-state') ||
        projectItem.classList.contains('maximized-state')
      )) {
        e.preventDefault();
        e.stopPropagation();
        restoreCard(projectItem);
      }
    });

    // Mostrar un feedback simple al pulsar el botón de restaurar (no restaura todo por ahora)
    if (actionButton) {
      actionButton.addEventListener('click', async (ev) => {
        ev.preventDefault();
        if (closedProjects.length === 0) return;

        // Disable button while restoring
        actionButton.style.pointerEvents = 'none';
        actionButton.classList.remove('show');

        // Small pop animation
        actionButton.animate([
          { transform: 'translateY(0)' },
          { transform: 'translateY(-8px)' },
          { transform: 'translateY(0)' }
        ], { duration: 260 });

        console.log('Restore ALL clicked, restoring', closedProjects.length, 'items');

        // Work on a shallow copy because restoreCard will modify the array
        const toRestore = closedProjects.slice();

        for (let i = 0; i < toRestore.length; i++) {
          const item = toRestore[i];
          try {
            // Add a tiny stagger for visibility
            restoreCard(item);
            console.log('Restored item index:', item.getAttribute && item.getAttribute('data-index'));
            // Wait a bit so user sees the individual restores (skip if prefers-reduced-motion)
            if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              await new Promise(r => setTimeout(r, 120));
            }
          } catch (err) {
            console.error('Error restoring item', err);
          }
        }

        // Ensure array cleared and UI updated
        closedProjects.length = 0;
        updateRestoreButton();
        console.log('All restored, closedProjects count now:', closedProjects.length);

        // Re-enable pointer events (updateRestoreButton may hide the button)
        actionButton.style.pointerEvents = '';
      });
    }

    // Cleanup
    window.addEventListener('beforeunload', () => {
      if (animationId) {
        cancelAnimationFrame(animationId);
      }
    });
  });
</script>

<style>
