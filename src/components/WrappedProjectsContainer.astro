---
// src/components/WrappedProjectsContainer.astro
import DraggableProjectCard from './DraggableProjectCard.astro';

interface Props {
  projects: Array<{ 
    id: number; 
    title: string; 
    description: string; 
    url: string;
  }>;
}

const { projects } = Astro.props;

// Definir diferentes iconos minimalistas para cada proyecto con colores del gradiente macOS
const projectIcons = [
  // Icono 1: Código (My First Web) - Rosa coral
  '<svg class="w-12 h-12 gradient-icon-1" fill="none" stroke="#ff9a9e" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>',
  // Icono 2: Tienda (Sell In A Flash) - Melocotón
  '<svg class="w-12 h-12 gradient-icon-2" fill="none" stroke="#fad0c4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>',
  // Icono 3: Gestión (Maneja Tu Proyecto) - Azul lavanda
  '<svg class="w-12 h-12 gradient-icon-3" fill="none" stroke="#a1c4fd" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>',
  // Icono 4: Memoria/Foto (Harvard Memories) - Azul cielo
  '<svg class="w-12 h-12 gradient-icon-4" fill="none" stroke="#c2e9fb" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>',
  // Icono 5: Dev.to (DevTo Fun) - Rosa coral intenso
  '<svg class="w-12 h-12 gradient-icon-1" fill="none" stroke="#ff9a9e" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>',
  // Icono 6: Aviación (Airman Project) - Melocotón
  '<svg class="w-12 h-12 gradient-icon-2" fill="none" stroke="#fad0c4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>',
  // Icono 7: Gráfico/Datos (Vet Análisis Datos) - Azul lavanda
  '<svg class="w-12 h-12 gradient-icon-3" fill="none" stroke="#a1c4fd" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>',
  // Icono 8: Pensamiento/Idea (CS50Thoughts) - Azul cielo
  '<svg class="w-12 h-12 gradient-icon-4" fill="none" stroke="#c2e9fb" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>'
];

// Clases de texto con gradientes para títulos
const gradientTitleClasses = [
  'gradient-text-title-1', // Rosa coral
  'gradient-text-title-2', // Melocotón  
  'gradient-text-title-3', // Azul lavanda
  'gradient-text-title-4', // Azul cielo
  'gradient-text-title-1', // Repetir patrón
  'gradient-text-title-2',
  'gradient-text-title-3', 
  'gradient-text-title-4'
];

// Clases de texto con gradientes para descripciones
const gradientDescClasses = [
  'gradient-text-desc-1', // Rosa coral suave
  'gradient-text-desc-2', // Melocotón suave
  'gradient-text-desc-3', // Azul lavanda suave
  'gradient-text-desc-4', // Azul cielo suave
  'gradient-text-desc-1', // Repetir patrón
  'gradient-text-desc-2',
  'gradient-text-desc-3',
  'gradient-text-desc-4'
];

// Tamaños tipo "bento" deterministas (evita parpadeo al re-render)
function bentoSize(index: number) {
  const sizes = [
    'w-[18rem] h-[18rem]',
    'w-[22rem] h-[18rem]',
    'w-[18rem] h-[24rem]',
    'w-[26rem] h-[20rem]',
    'w-[20rem] h-[20rem]',
    'w-[24rem] h-[26rem]',
    'w-[18rem] h-[22rem]',
    'w-[22rem] h-[24rem]'
  ];
  return sizes[index % sizes.length];
}
---

<!-- Carrusel horizontal infinito -->
<div class="projects-infinite-wrapper relative h-full w-full overflow-hidden">
  <div id="wrapped-projects-container" class="infinite-container scrollbar-hide" style="scrollbar-width:none; -ms-overflow-style:none;">
    <div class="projects-track">
      {(() => {
        // Precomputar tamaños deterministas para consistencia entre duplicados
        const sizes = projects.map((_, i) => bentoSize(i));
        // Duplicar los proyectos para crear el efecto infinito
        const duplicatedProjects = [...projects, ...projects];
        
        return duplicatedProjects.map((project, index) => {
          const originalIndex = index % projects.length;
          return (
            <DraggableProjectCard
              project={project}
              index={originalIndex}
              isDuplicate={index >= projects.length}
              class={`preload ${sizes[originalIndex]}`}
              iconSvg={projectIcons[originalIndex % projectIcons.length]}
              gradientTitleClass={gradientTitleClasses[originalIndex % gradientTitleClasses.length]}
              gradientDescClass={gradientDescClasses[originalIndex % gradientDescClasses.length]}
            />
          );
        });
      })()}
    </div>
  </div>
  
  <!-- Indicadores de scroll (opcional) -->
  <div class="scroll-indicators absolute bottom-4 left-1/2 transform -translate-x-1/2 flex space-x-2 z-10">
    <div class="scroll-indicator w-2 h-2 bg-white/30 rounded-full"></div>
    <div class="scroll-indicator w-2 h-2 bg-white/30 rounded-full"></div>
    <div class="scroll-indicator w-2 h-2 bg-white/50 rounded-full"></div>
  </div>
</div>

<!-- Botón visual macOS (solo UI) en la esquina inferior derecha -->
<div id="macos-restore-button" class="macos-restore-button" role="button" tabindex="0" aria-label="Restaurar ventanas cerradas" hidden>
  <div class="macos-restore-button-inner">
    <span class="macos-restore-label">Restore</span>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('wrapped-projects-container');
    const track = container?.querySelector('.projects-track');
    const actionButton = document.getElementById('macos-restore-button');
    if (!container || !track) return;

    // Obtener los proyectos desde los elementos del DOM
    // Nota: draggable-project-card tiene la clase .project-item
    const initialCards = Array.from(track.querySelectorAll('.project-item'));
    const projects = [];
    
    // Extraer información inicial
    initialCards.forEach((card, index) => {
      const originalIndex = parseInt(card.getAttribute('data-index')) || 0;
      if (originalIndex < projects.length) return; 
      
      const title = card.querySelector('.project-title')?.textContent.trim() || `Project ${originalIndex + 1}`;
      const description = card.querySelector('.project-desc')?.textContent.trim() || `Description for project ${originalIndex + 1}`;
      const url = card.getAttribute('data-url') || '#';
      
      projects.push({
        id: originalIndex,
        title,
        description,
        url
      });
    });

    const uniqueProjects = projects.filter((project, index, self) => 
      index === self.findIndex(p => p.id === project.id)
    );

    console.log('Proyectos cargados:', uniqueProjects);

    const closedProjects = [];
    let audioContext = null;

    function playHoverSound() {
      try {
        if (!audioContext) {
          audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioContext.state === 'suspended') {
           audioContext.resume().catch(() => {});
        }
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();
        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);
        oscillator.type = 'sine';
        oscillator.frequency.setValueAtTime(500, audioContext.currentTime); 
        oscillator.frequency.exponentialRampToValueAtTime(800, audioContext.currentTime + 0.05); 
        gainNode.gain.setValueAtTime(0, audioContext.currentTime);
        gainNode.gain.linearRampToValueAtTime(0.015, audioContext.currentTime + 0.01);
        gainNode.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.1);
        oscillator.start();
        oscillator.stop(audioContext.currentTime + 0.1);
      } catch (e) {}
    }
    
    let currentBatch = 0;
    let isLoading = false;
    const BATCH_SIZE = uniqueProjects.length;
    let allProjectCards = [...uniqueProjects, ...uniqueProjects];

    function updateRestoreButton() {
      if (!actionButton) return;
      if (closedProjects.length > 0) {
        actionButton.removeAttribute('hidden');
        actionButton.classList.add('show');
        actionButton.setAttribute('aria-label', `Restaurar ${closedProjects.length} ventanas`);
        actionButton.style.pointerEvents = 'auto';
      } else {
        actionButton.classList.remove('show');
        actionButton.setAttribute('aria-label', 'Restaurar ventanas cerradas');
        actionButton.style.pointerEvents = 'none';
        actionButton.setAttribute('hidden', '');
      }
    }

    function addClosedProject(projectItem) {
      if (!projectItem) return;
      if (!closedProjects.includes(projectItem)) {
        closedProjects.push(projectItem);
      }
      updateRestoreButton();
    }

    function removeClosedProject(projectItem) {
      const idx = closedProjects.indexOf(projectItem);
      if (idx !== -1) closedProjects.splice(idx, 1);
      updateRestoreButton();
    }

    function createProjectCard(project, index, isDuplicate = false) {
      const originalIndex = index % uniqueProjects.length;
      const sizes = [
        'w-[18rem] h-[18rem]', 'w-[22rem] h-[18rem]', 'w-[18rem] h-[24rem]', 'w-[26rem] h-[20rem]',
        'w-[20rem] h-[20rem]', 'w-[24rem] h-[26rem]', 'w-[18rem] h-[22rem]', 'w-[22rem] h-[24rem]'
      ];
      
      const projectIcons = [
        '<svg class="w-12 h-12 gradient-icon-1" fill="none" stroke="#ff9a9e" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-2" fill="none" stroke="#fad0c4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-3" fill="none" stroke="#a1c4fd" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-4" fill="none" stroke="#c2e9fb" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-1" fill="none" stroke="#ff9a9e" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-2" fill="none" stroke="#fad0c4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-3" fill="none" stroke="#a1c4fd" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>',
        '<svg class="w-12 h-12 gradient-icon-4" fill="none" stroke="#c2e9fb" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>'
      ];

      const gradientTitleClasses = [
        'gradient-text-title-1', 'gradient-text-title-2', 'gradient-text-title-3', 'gradient-text-title-4',
        'gradient-text-title-1', 'gradient-text-title-2', 'gradient-text-title-3', 'gradient-text-title-4'
      ];

      const gradientDescClasses = [
        'gradient-text-desc-1', 'gradient-text-desc-2', 'gradient-text-desc-3', 'gradient-text-desc-4',
        'gradient-text-desc-1', 'gradient-text-desc-2', 'gradient-text-desc-3', 'gradient-text-desc-4'
      ];

      // Use the Custom Element
      const cardElement = document.createElement('draggable-project-card');
      const entryClass = isDuplicate ? 'dynamic-entry' : 'preload';
      
      // Set the attributes expected by DraggableProjectCard logic
      cardElement.className = `project-item ${entryClass} ${sizes[originalIndex]} shadow-lg transition-all duration-300 transform hover:-translate-y-1 hover:scale-105`;
      cardElement.setAttribute('data-index', originalIndex);
      cardElement.setAttribute('data-duplicate', isDuplicate ? 'true' : 'false');
      // Pass the link as data-url, component logic handles double click open
      cardElement.setAttribute('data-url', project.url);

      // Recreate internal DOM structure
      cardElement.innerHTML = `
        <div class="project-card-visual glass-card group w-full h-full relative rounded-3xl overflow-hidden transition-all duration-300 cursor-grab active:cursor-grabbing">
            <!-- Window Controls Bar -->
            <div class="window-controls-bar absolute top-0 left-0 w-full h-12 z-20 flex items-center px-4">
                <div class="window-controls flex space-x-2 transition-all duration-300 pointer-events-auto">
                    <div class="window-control-btn window-control-close"></div>
                    <div class="window-control-btn window-control-minimize"></div>
                    <div class="window-control-btn window-control-maximize"></div>
                </div>
            </div>
            
            <div class="project-item-inner flex flex-col items-center justify-center p-6 h-full pt-12 pointer-events-none">
              <div class="project-icon w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-50/50 to-purple-50/50 flex items-center justify-center border-white/20 mb-4 pointer-events-auto transition-transform duration-300">
                <div>${projectIcons[originalIndex % projectIcons.length]}</div>
              </div>
              <h3 class="project-title project-text-base text-lg font-semibold mb-2 text-center leading-tight ${gradientTitleClasses[originalIndex % gradientTitleClasses.length]} pointer-events-auto">${project.title}</h3>
              <p class="project-desc project-text-base text-center text-sm line-clamp-3 leading-relaxed ${gradientDescClasses[originalIndex % gradientDescClasses.length]} pointer-events-auto">${project.description}</p>
            </div>
        </div>
      `;

      return cardElement;
    }

    function loadMoreCards() {
      if (isLoading) return;
      isLoading = true;
      requestAnimationFrame(() => {
        const newCards = [];
        for (let i = 0; i < BATCH_SIZE; i++) {
          const projectIndex = i % uniqueProjects.length;
          const newCard = createProjectCard(uniqueProjects[projectIndex], projectIndex, true);
          newCards.push(newCard);
          allProjectCards.push(uniqueProjects[projectIndex]);
        }
        
        newCards.forEach((card, index) => {
          track.appendChild(card);
          const totalCards = track.querySelectorAll('.project-item').length;
          const cardPosition = totalCards - newCards.length + index;
          applyMasonryStyles(card, cardPosition);
          setupCardEventListeners(card);
          requestAnimationFrame(() => { card.classList.add('loaded'); });
        });
        
        currentBatch++;
        isLoading = false;
      });
    }

    function applyMasonryStyles(card, position) {
      card.style.alignSelf = '';
      card.style.marginTop = '';
      const remainder = position % 5;
      switch(remainder) {
        case 0: card.style.alignSelf = 'flex-start'; break;
        case 1: card.style.alignSelf = 'center'; break;
        case 2: card.style.alignSelf = 'flex-end'; break;
        case 3: card.style.alignSelf = 'flex-start'; card.style.marginTop = '2rem'; break;
        case 4: card.style.alignSelf = 'center'; card.style.marginTop = '1rem'; break;
      }
    }

    // Attach external listeners (sound, restore tracking)
    function setupCardEventListeners(card) {
      card.addEventListener('mouseenter', () => { isPaused = true; playHoverSound(); });
      card.addEventListener('mouseleave', () => {
        const anyHover = Array.from(track.querySelectorAll('.project-item')).some(c => c.matches(':hover'));
        if (!anyHover) isPaused = false;
      });

      // Window controls logic integration
      const windowControls = card.querySelectorAll('.window-control-btn');
      windowControls.forEach(btn => {
        btn.addEventListener('click', (e) => {
          // DraggableProjectCard component handles visual state
          // We need to track it in global closedProjects list
          const projectItem = btn.closest('.project-item');
          if (btn.classList.contains('window-control-close')) {
             setTimeout(() => addClosedProject(projectItem), 600);
          } else if (btn.classList.contains('window-control-maximize') || btn.classList.contains('window-control-minimize')) {
             // Just state change, no restore tracking needed for min/max in the list?
             // Actually, min/max cards are still visible or docked, not "closed/gone"
          }
        });
      });
    }

    function restoreCard(projectItem) {
      // Logic to trigger restore on the component
      // We can manually remove the classes
      projectItem.classList.remove('closed-state', 'minimized-state', 'maximized-state');
      projectItem.style.position = '';
      projectItem.style.top = '';
      projectItem.style.left = '';
      projectItem.style.transform = '';
      projectItem.style.zIndex = '';
      removeClosedProject(projectItem);
    }
    
    // Global Restore Button Logic
    if (actionButton) {
      actionButton.addEventListener('click', async (ev) => {
        ev.preventDefault();
        if (closedProjects.length === 0) return;
        actionButton.style.pointerEvents = 'none';
        actionButton.classList.remove('show');
        
        const toRestore = closedProjects.slice();
        for (let i = 0; i < toRestore.length; i++) {
          const item = toRestore[i];
          restoreCard(item);
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            await new Promise(r => setTimeout(r, 120));
          }
        }
        closedProjects.length = 0;
        updateRestoreButton();
        actionButton.style.pointerEvents = '';
      });
    }

    // Infinite Scroll Logic
    let isPaused = false;
    let animationId = null;
    let isDragging = false;
    let startX = 0;
    let scrollLeft = 0;
    let preciseScrollLeft = 0;
    let lastTimestamp = 0;
    const SCROLL_SPEED_PPS = 60; 

    function autoScroll(timestamp) {
      if (!lastTimestamp || isPaused || isDragging) lastTimestamp = timestamp;
      if (!isPaused && !isDragging) {
        const deltaTime = timestamp - lastTimestamp;
        lastTimestamp = timestamp;
        const pixelsToMove = (SCROLL_SPEED_PPS * deltaTime) / 1000;
        if (Math.abs(container.scrollLeft - preciseScrollLeft) > 5) preciseScrollLeft = container.scrollLeft;
        preciseScrollLeft += pixelsToMove;
        container.scrollLeft = preciseScrollLeft;

        const maxScroll = container.scrollWidth - container.clientWidth;
        if (container.scrollLeft >= maxScroll * 0.8 && !isLoading) loadMoreCards();
      } else {
         preciseScrollLeft = container.scrollLeft;
      }
      animationId = requestAnimationFrame(autoScroll);
    }

    function animateCardsIn() {
      const cards = Array.from(track.querySelectorAll('.project-item'));
      requestAnimationFrame(() => {
        let i = 0;
        const step = () => {
          if (i >= cards.length) {
            setTimeout(() => cards.forEach(c => c.classList.remove('preload')), 600);
            return;
          }
          cards[i].classList.add('loaded');
          i += 1;
          setTimeout(() => requestAnimationFrame(step), 40);
        };
        step();
      });
    }

    setTimeout(() => { preciseScrollLeft = container.scrollLeft; requestAnimationFrame(autoScroll); }, 100);
    setTimeout(animateCardsIn, 80);

    // Track dragging (scroll the container)
    function startTrackDrag(e) {
      // If we clicked inside a DraggableProjectCard, DON'T scroll the track.
      // The card handles its own dragging now.
      if (e.target.closest('draggable-project-card') || e.target.closest('.window-controls')) return;
      
      isDragging = true;
      container.style.cursor = 'grabbing';
      startX = (e.pageX || e.touches[0].pageX) - container.offsetLeft;
      scrollLeft = container.scrollLeft;
    }

    function stopTrackDrag() {
      if(!isDragging) return;
      isDragging = false;
      container.style.cursor = 'grab';
    }

    function performTrackDrag(e) {
      if (!isDragging) return;
      e.preventDefault();
      const x = (e.pageX || e.touches[0].pageX) - container.offsetLeft;
      const walk = (x - startX) * 2;
      container.scrollLeft = scrollLeft - walk;
    }

    container.addEventListener('mousedown', startTrackDrag);
    container.addEventListener('touchstart', startTrackDrag, { passive: true });
    
    // Attach to document for full window drag tracking
    document.addEventListener('mouseup', stopTrackDrag);
    document.addEventListener('touchend', stopTrackDrag);
    document.addEventListener('mousemove', performTrackDrag);
    document.addEventListener('touchmove', performTrackDrag, { passive: true });

    initialCards.forEach(card => setupCardEventListeners(card));
  });
</script>

