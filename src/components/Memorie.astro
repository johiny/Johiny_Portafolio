---
const {text_left, text_right, title, cardImg, url} = Astro.props
---

<section class="flex flex-col md:flex-row items-center justify-between p-4 bg-opacity-10 rounded-xl backdrop-blur-sm border border-opacity-20 hover:shadow-lg transition-shadow duration-300">
    <div class="md:w-2/5 mb-4 md:mb-0 md:pr-4">
        <h3 class="text-justify text-sm md:text-base">{text_left}</h3>
    </div>
    <div class="md:w-1/5 mb-4 md:mb-0 flex justify-center">
        <img src={cardImg} alt={title} class="w-32 h-32 object-cover rounded-lg shadow-md" />
    </div>
    <div class="md:w-2/5 md:pl-4">
        <h3 class="text-justify text-sm md:text-base">{text_right}</h3>
    </div>
</section>


<style>
     @import url('https://fonts.googleapis.com/css2?family=Source+Code+Pro&display=swap');
     h3{
        font-family: 'Source Code Pro', monospace;
        font-weight: 100;
     }
     h2{
        font-family: 'Source Code Pro', monospace;
        font-weight: 100;
     }
     .hide{
        opacity: 0;
    }
    section{
        perspective: 1000px;
        perspective-origin: 50% 50%;
    } 
</style>