---
---

<div class={`flex flex-col items-center justify-center p-2 ${Astro.props.class || ''}`}>
  <div class="flex space-x-3 mb-1">
    <a href="https://github.com/johiny" title="Github Link">
      <i class="fa-brands fa-github text-xl hover:text-aeroBlue transition-colors duration-300"></i>
    </a>
    <a href="https://www.linkedin.com/in/johan-sebastian-c-mazo/" title="Linkedin Link">
      <i class="fa-brands fa-linkedin text-xl hover:text-aeroBlue transition-colors duration-300"></i>
    </a>
    <a href="https://twitter.com/johinyDev" title="Twitter Link">
      <i class="fa-brands fa-twitter text-xl hover:text-aeroBlue transition-colors duration-300"></i>
    </a>
    <a href="mailto:contact@johiny.dev" title="Email">
      <i class="fa fa-envelope text-xl hover:text-aeroBlue transition-colors duration-300"></i>
    </a>
  </div>
  <p class="text-xs">© {new Date().getFullYear()} Johiny Dev</p>
</div>

<style>
  :root[data-theme="light"] div {
    --iconscolor: #121212;
  }
  :root[data-theme="dark"] div {
    --iconscolor: #C2E7D9;
  }
  
  div {
    font-family: 'Source Code Pro', monospace;
    color: var(--iconscolor);
  }

  i {
    color: var(--iconscolor);
    transition: all ease-in-out 200ms;
  }
  i:hover {
    transform: scale(1.2);
  }
</style>

<script is:inline src="https://kit.fontawesome.com/e1fe87383c.js" crossorigin="anonymous"></script>


