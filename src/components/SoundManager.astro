<script>
const playClickSound = () => {
  const audio = new Audio('/sounds/macos-click.mp3');
  audio.volume = 0.25;
  audio.play().catch(() => {});
};

document.addEventListener('DOMContentLoaded', () => {
  const interactiveElements = 'a, button, .window-control-btn, .dock-item, .mac-social-link, .sort-btn, [role="button"], .project-item, .chat-control-btn';
  
  document.querySelectorAll(interactiveElements).forEach(el => {
    el.addEventListener('click', playClickSound);
  });
  
  document.addEventListener('DOMNodeInserted', (e) => {
    if (e.target.nodeType === Node.ELEMENT_NODE) {
      e.target.querySelectorAll(interactiveElements).forEach(el => {
        el.addEventListener('click', playClickSound);
      });
    }
  });
});
</script>
